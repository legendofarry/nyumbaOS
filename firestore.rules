rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rolePath() {
      return /databases/$(database)/documents/user_roles/$(request.auth.uid);
    }

    function role() {
      return signedIn() && exists(rolePath()) ? get(rolePath()).data.role : null;
    }

    function isOwner() {
      return role() == "owner";
    }

    function isAssistant() {
      return role() == "assistant";
    }

    function isOwnerTeam() {
      return isOwner() || isAssistant();
    }

    function isTenant() {
      return role() == "tenant";
    }

    function ownsProfile(profileId) {
      return signedIn() && request.auth.uid == profileId;
    }

    function ownsUnit(unitId) {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.unit_id == unitId;
    }

    match /profiles/{profileId} {
      allow read: if signedIn();
      allow create: if isOwnerTeam() || ownsProfile(profileId);
      allow update: if isOwnerTeam() || ownsProfile(profileId);
      allow delete: if isOwnerTeam();
    }

    match /user_roles/{userId} {
      // Public list lets the auth screen check whether owner/assistant accounts exist.
      // Documents contain role metadata only; keep email/phone data in profiles.
      allow list: if true;
      allow get: if isOwnerTeam() || ownsProfile(userId);
      allow create: if (
          isOwnerTeam()
          && request.resource.data.role in ["owner", "assistant", "tenant"]
        )
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.user_id == userId
          && request.resource.data.role in ["owner", "assistant", "tenant"]
        );
      allow update, delete: if isOwnerTeam();
    }

    match /units/{unitId} {
      allow read: if signedIn();
      allow write: if isOwnerTeam();
    }

    match /unit_auth/{unitId} {
      // PIN hashes and auth metadata must never be readable by clients.
      allow read: if false;
      allow create, update, delete: if isOwnerTeam();
    }

    match /management_auth/{docId} {
      // Management PIN hashes must never be readable or writable by clients.
      allow read: if false;
      allow write: if false;
    }

    match /trustedDevices/{deviceId} {
      // Trusted device tokens must only be managed server-side (via admin SDK / Cloud Functions)
      allow read: if false;
      allow write: if false;
    }

    match /tenant_logins/{unitId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isOwnerTeam();
    }

    match /payments/{paymentId} {
      allow read: if isOwnerTeam() || (isTenant() && resource.data.tenant_id == request.auth.uid);
      allow write: if isOwnerTeam();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if isOwnerTeam() || (signedIn() && resource.data.author_id == request.auth.uid);
    }

    match /messages/{messageId} {
      allow read: if isOwnerTeam() || (signedIn() && (resource.data.sender_id == request.auth.uid || resource.data.recipient_id == request.auth.uid));
      allow create: if signedIn() && request.resource.data.sender_id == request.auth.uid;
      allow update, delete: if isOwnerTeam() || (signedIn() && (resource.data.sender_id == request.auth.uid || resource.data.recipient_id == request.auth.uid));
    }

    match /readings/{readingId} {
      allow read: if isOwnerTeam() || (isTenant() && ownsUnit(resource.data.unit_id));
      allow write: if isOwnerTeam();
    }

    match /tickets/{ticketId} {
      allow read: if isOwnerTeam() || (isTenant() && ownsUnit(resource.data.unit_id));
      allow create: if isOwnerTeam()
        || (isTenant() && request.resource.data.created_by == request.auth.uid);
      allow update, delete: if isOwnerTeam();
    }

    match /notices/{noticeId} {
      allow read: if signedIn();
      allow write: if isOwnerTeam();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if isOwnerTeam();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
